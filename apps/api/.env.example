# API settings for LOCAL development. Copy to .env (npm run setup does it for you).
# Values here are local-only defaults — never put real secrets in this file.
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Postgres from docker-compose.yml
DATABASE_URL=postgres://mom:mom@localhost:5432/mom

# S3-compatible storage from docker-compose.yml (SeaweedFS). On AWS, leave
# S3_ENDPOINT and the keys empty: real S3 + the task IAM role are used.
S3_ENDPOINT=http://localhost:8333
S3_REGION=ap-south-1
S3_BUCKET=mom-images
S3_ACCESS_KEY_ID=mom-dev-access-key
S3_SECRET_ACCESS_KEY=mom-dev-secret-key
S3_FORCE_PATH_STYLE=true
PUBLIC_IMAGE_BASE_URL=http://localhost:8333/mom-images

# console = OTP codes are printed in the API terminal instead of being sent
SMS_PROVIDER=console
