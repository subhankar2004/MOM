{
  "name": "@mom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --clear-screen=false src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "env:check": "tsx --env-file-if-exists=.env src/scripts/check-env.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1170.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@mom/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
