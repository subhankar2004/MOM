# API settings for LOCAL development. Copy to .env (npm run setup does it for you).
# Values here are local-only defaults — never put real secrets in this file.
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Postgres from docker-compose.yml
DATABASE_URL=postgres://mom:mom@localhost:5432/mom

# S3-compatible storage from docker-compose.yml (SeaweedFS). On AWS, leave
# S3_ENDPOINT and the keys empty: real S3 + the task IAM role are used.
S3_ENDPOINT=http://localhost:8333
S3_REGION=ap-south-1
S3_BUCKET=mom-images
S3_ACCESS_KEY_ID=mom-dev-access-key
S3_SECRET_ACCESS_KEY=mom-dev-secret-key
S3_FORCE_PATH_STYLE=true
PUBLIC_IMAGE_BASE_URL=http://localhost:8333/mom-images

# console = OTP codes are printed in the API terminal instead of being sent
SMS_PROVIDER=console

# Login secrets — `npm run setup` fills these with random values for your machine.
JWT_SECRET=
OTP_PEPPER=
QR_SECRET=

# Optional: phones that get a fixed code instead of an SMS (never in production)
# SMS_TEST_PHONES=9000000001
# SMS_TEST_CODE=123456

# Your own mobile number(s), comma separated: these accounts become super admins
# when the database is seeded (npm run db:seed) and on login (#9). Example: 98765 43210
SUPER_ADMIN_PHONES=

# Optional (defaults shown):
# API_HOST=127.0.0.1          # the Docker image uses 0.0.0.0
# TRUST_PROXY_HOPS=0          # 1 behind the AWS load balancer
# RATE_LIMIT_PER_MINUTE=300   # per IP
# API_DOCS=true               # /docs; off by default in production

# Razorpay (UPI payments). Leave empty and UPI is simply not offered.
# Test keys: dashboard.razorpay.com → Test Mode → Settings → API Keys. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random text; enter the same value in Razorpay → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=
